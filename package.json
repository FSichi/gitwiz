{
  "name": "@fsichi/gitwiz",
  "version": "1.1.0",
  "description": "Friendly git workflow CLI — interactive wizards for branching, commits, releases, sync, and undo",
  "keywords": [
    "git",
    "cli",
    "workflow",
    "conventional-commits",
    "changelog",
    "wizard",
    "git-flow",
    "release"
  ],
  "license": "MIT",
  "author": "Facundo Sichi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FSichi/gitwiz.git"
  },
  "bugs": {
    "url": "https://github.com/FSichi/gitwiz/issues"
  },
  "homepage": "https://github.com/FSichi/gitwiz#readme",
  "type": "module",
  "bin": {
    "gitwiz": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.4",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/semver": "^7.7.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  }
}